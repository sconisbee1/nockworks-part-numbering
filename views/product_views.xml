<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_nw_numbering" model="ir.ui.view">
        <field name="name">product.template.form.nockworks.numbering</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="NockWorks Part Number" name="nw_part_numbering">
                    <field name="product_variant_count" invisible="True"/>
                    <field name="nw_part_number_assigned" invisible="True"/>
                    <group invisible="product_variant_count != 1">
                        <field name="nw_part_number" class="oe_inline fw-bold fs-4"/>
                        <field name="nw_part_category_id" readonly="nw_part_number_assigned" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="nw_part_type_id" domain="[('category_id', '=', nw_part_category_id)]" readonly="nw_part_number_assigned" options="{'no_create': True, 'no_create_edit': True}"/>
                        <button name="action_generate_nw_part_number" type="object" string="Generate Part Number" class="btn-primary" invisible="not nw_part_category_id or not nw_part_type_id or nw_part_number_assigned"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="product_variant_count &lt;= 1">
                        This template has multiple variants. Open each product variant to assign its unique NockWorks part number.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_nw_numbering" model="ir.ui.view">
        <field name="name">product.product.form.nockworks.numbering</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="NockWorks Part Number" name="nw_part_numbering_variant">
                    <field name="nw_part_number_assigned" invisible="True"/>
                    <field name="nw_part_number" class="oe_inline fw-bold fs-4"/>
                    <field name="nw_part_category_id" readonly="nw_part_number_assigned" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="nw_part_type_id" domain="[('category_id', '=', nw_part_category_id)]" readonly="nw_part_number_assigned" options="{'no_create': True, 'no_create_edit': True}"/>
                    <button name="action_generate_nw_part_number" type="object" string="Generate Part Number" class="btn-primary" invisible="not nw_part_category_id or not nw_part_type_id or nw_part_number_assigned"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
