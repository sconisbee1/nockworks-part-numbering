<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nw_part_category_list" model="ir.ui.view">
        <field name="name">nockworks.part.category.list</field>
        <field name="model">nockworks.part.category</field>
        <field name="arch" type="xml">
            <list default_order="code">
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_nw_part_category_form" model="ir.ui.view">
        <field name="name">nockworks.part.category.form</field>
        <field name="model">nockworks.part.category</field>
        <field name="arch" type="xml">
            <form string="Part Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Part Types" name="part_types">
                            <field name="type_ids">
                                <list editable="bottom" default_order="code">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="next_number"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Engineering classification notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nw_part_categories" model="ir.actions.act_window">
        <field name="name">Part Categories</field>
        <field name="res_model">nockworks.part.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

