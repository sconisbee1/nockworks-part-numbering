<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nw_part_type_list" model="ir.ui.view">
        <field name="name">nockworks.part.type.list</field>
        <field name="model">nockworks.part.type</field>
        <field name="arch" type="xml">
            <list default_order="category_code, code">
                <field name="category_id"/>
                <field name="category_code" column_invisible="True"/>
                <field name="code"/>
                <field name="name"/>
                <field name="next_number"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_nw_part_type_form" model="ir.ui.view">
        <field name="name">nockworks.part.type.form</field>
        <field name="model">nockworks.part.type</field>
        <field name="arch" type="xml">
            <form string="Part Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="next_number"/>
                            <field name="sequence_exhausted"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Engineering classification notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nw_part_types" model="ir.actions.act_window">
        <field name="name">Part Types</field>
        <field name="res_model">nockworks.part.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

